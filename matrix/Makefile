CC = gccCFLAGS = -Wall -Wextra -Werror -std=c11GFLAGS = -fprofile-arcs -ftest-coverageSRC = s21_matrix.c s21_help.cOBJ = $(SRC:.c=.o)LIB = s21_matrix.aLDFLAGS = $(shell pkg-config --libs check)INCLUDES = $(shell pkg-config --cflags check)TEST_DIR = testsTEST_MAIN = $(TEST_DIR)/test.cTEST_SRC = $(wildcard $(TEST_DIR)/test_*.c)TEST_OBJ = $(TEST_SRC:.c=.o)TEST_EXE = test.PHONY: all clean $(LIB) test gcov_report clang valgrind leaks cppcheckall: $(LIB)$(LIB): $(OBJ)	ar rcs $@ $^%.o: %.c	$(CC) $(CFLAGS) -c $< -o $@$(TEST_DIR)/%.o: $(TEST_DIR)/%.c	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@test: clean $(TEST_OBJ) $(TEST_MAIN:.c=.o)	$(CC) $(CFLAGS) $(GFLAGS) -c s21_matrix.c -o s21_matrix.o	$(CC) $(CFLAGS) $(GFLAGS) -c s21_help.c -o s21_help.o	ar rcs $(LIB) *.o	$(CC) $(CFLAGS) $(GFLAGS) $(INCLUDES) $(TEST_OBJ) $(TEST_MAIN:.c=.o) $(LIB) -o $(TEST_EXE) $(LDFLAGS)	./$(TEST_EXE)gcov_report: test	gcov -o s21_matrix.c s21_help.c	lcov --capture --directory . --output-file coverage.info	genhtml coverage.info --output-directory lcov-report	open lcov-report/index.html || xdg-open lcov-report/index.htmlclang:	clang-format -i *.c *.h */*.c */*.hvalgrind:	valgrind --tool=memcheck --leak-check=yes ./$(TEST_EXE)leaks:	leaks -atExit -- ./$(TEST_EXE) | grep LEAK:cppcheck:	cppcheck --enable=all --std=c11 --check-level=exhaustive --disable=information --suppress=missingIncludeSystem --suppress=missingInclude --suppress=checkersReport .clean:	rm -f $(LIB) $(LIB_GCOV) $(TEST_EXE)	find . -type f \( -name "*.gcno" -o -name "*.gcda" -o -name "*.gcov" -o -name "*.o" \) -delete	rm -rf lcov-report	rm -f coverage.info